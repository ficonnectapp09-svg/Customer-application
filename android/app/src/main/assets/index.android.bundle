  function getParsedInvoiceItems(order) {
    if (order.items && order.items.length > 0) {
      return order.items.map(it => {
        var q = it.quantity || 1;
        var p = it.price || 0;
        return {
          name: it.name || 'Item',
          quantity: q,
          price: p,
          total: q * p
        };
      });
    }

    // Parse product_details string if items array is absent
    var detailsStr = order.product_details || 'Order Item';
    var rawParts = detailsStr.split(/,|\n|\u2022|;/).map(s => s.trim()).filter(Boolean);
    if (rawParts.length === 0) {
      return [{
        name: 'Order Item',
        quantity: 1,
        price: order.amount || 0,
        total: order.amount || 0
      }];
    }

    // Try parsing items like "Organic A2 Milk 1L (x2)" or "2 x Fresh Avocados - ₹180"
    var parsedItems = [];
    var calculatedSum = 0;
    rawParts.forEach(part => {
      var qty = 1;
      var name = part;
      var price = 0;

      // Check quantity pattern like (x2) or 2x
      var qtyMatch = part.match(/\(x(\d+)\)/i) || part.match(/^(\d+)\s*x\s+/i);
      if (qtyMatch) {
        qty = parseInt(qtyMatch[1], 10) || 1;
        name = part.replace(/\(x\d+\)/i, '').replace(/^\d+\s*x\s+/i, '').trim();
      }

      // Check price pattern inside item string like ₹180 or Rs. 180
      var priceMatch = part.match(/(?:₹|Rs\.?)\s*(\d+(?:\.\d+)?)/i);
      if (priceMatch) {
        price = parseFloat(priceMatch[1]) || 0;
        name = name.replace(/(?:₹|Rs\.?)\s*\d+(?:\.\d+)?/i, '').trim();
      }
      var itemTotal = qty * (price > 0 ? price : 0);
      calculatedSum += itemTotal;
      parsedItems.push({
        name: name || 'Item',
        quantity: qty,
        price: price > 0 ? price : 0,
        total: itemTotal
      });
    });

    // If parsed prices don't sum up to order.amount, distribute price proportionally or set estimate
    if (calculatedSum === 0 && parsedItems.length > 0) {
      var avgPrice = Math.round(order.amount / parsedItems.length);
      parsedItems.forEach(it => {
